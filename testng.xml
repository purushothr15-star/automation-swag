<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SwagLabsSuite" parallel="methods">

    <test thread-count="3" name="Login Tests">
        <classes>
            <class name="tests.LogInTest"/>
            <class name="tests.AddToCartTest"/>
            <class name="tests.HomePageTest">
                <methods>
                    <include name="verifyMenusTest" />
                </methods>
            </class>
        </classes>
    </test>
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="analyzer.MyTransformer"/>
    </listeners>
</suite>